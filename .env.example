# ============================================================
# Bakery Service — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in the values for your
# local development environment.
#
#   cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
# ============================================================

# --- gRPC server address (used by Frontend and Buyers) ------
BAKERY_SERVICE_ADDR=localhost:50051

# --- RabbitMQ connection string -----------------------------
RABBITMQ_SERVICE_ADDR=amqp://guest:guest@localhost:5672/

# --- PostgreSQL data source name ----------------------------
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DSN=postgres://postgres:password@localhost:5432/bakery?sslmode=disable

# --- JWT signing secret -------------------------------------
# Required. The server and frontend will refuse to start if this is not set.
# Generate a strong secret with:
#   openssl rand -hex 32
JWT_SECRET=

# --- CSRF protection key (frontend only) --------------------
# Required. Used by the frontend to sign CSRF cookies.
# Generate a strong key with:
#   openssl rand -hex 32
CSRF_KEY=
